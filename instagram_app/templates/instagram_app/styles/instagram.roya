#:roya 1.0

<InstagramPage@box_layout>:
    direction: "column"
    gap: "md"
    class_name: "ig-page"

<Topbar@box_layout>:
    direction: "row"
    gap: "md"
    class_name: "ig-topbar"

<BrandLabel@label>:
    text: "Roya"
    typography: "title"
    class_name: "ig-brand"

<SearchField@textfield>:
    type: "search"
    variant: "filled"
    class_name: "ig-search"

<HeaderActions@box_layout>:
    direction: "row"
    gap: "sm"
    class_name: "ig-header-actions"

<MainLayout@box_layout>:
    direction: "row"
    gap: "lg"
    class_name: "ig-main-layout"

<FeedColumn@box_layout>:
    direction: "column"
    gap: "md"
    class_name: "ig-feed-column"

<StoriesPanel@box_layout>:
    direction: "column"
    gap: "sm"
    class_name: "ig-stories-panel"

<StoryStrip@box_layout>:
    direction: "row"
    gap: "md"
    class_name: "ig-story-strip"

<StoryItem@stack_container>:
    direction: "column"
    gap: "xs"
    class_name: "ig-story-item"

<StoryAvatar@avatar>:
    size: "large"
    class_name: "ig-story-avatar"

<StoryOpenButton@button>:
    variant: "text"
    class_name: "ig-story-open"

<SectionTitle@label>:
    typography: "title"
    class_name: "ig-section-title"

<FeedHeading@box_layout>:
    direction: "column"
    gap: "xs"
    class_name: "ig-feed-heading"

<PostCard@box_layout>:
    direction: "column"
    gap: "sm"
    class_name: "ig-post-card"

<PostHeader@box_layout>:
    direction: "row"
    gap: "sm"
    class_name: "ig-post-header"

<PostIdentity@box_layout>:
    direction: "row"
    gap: "sm"
    class_name: "ig-post-identity"

<PostAvatar@avatar>:
    size: "medium"
    class_name: "ig-post-avatar"

<PostAuthor@box_layout>:
    direction: "column"
    gap: "xs"
    class_name: "ig-post-author"

<PostUsername@label>:
    typography: "label"
    class_name: "ig-post-username"

<PostLocation@label>:
    typography: "caption"
    class_name: "ig-post-location"

<PostMedia@image>:
    width: "100%"
    height: "auto"
    object_fit: "cover"
    class_name: "ig-post-media"

<PostPlaceholder@label>:
    class_name: "ig-post-placeholder"

<PostActions@box_layout>:
    direction: "row"
    gap: "sm"
    class_name: "ig-post-actions"

<PostActionGroup@box_layout>:
    direction: "row"
    gap: "sm"
    class_name: "ig-post-action-group"

<PostDetails@box_layout>:
    direction: "column"
    gap: "sm"
    class_name: "ig-post-details"

<PostLikes@label>:
    typography: "label"
    class_name: "ig-post-likes"

<PostCaption@label>:
    typography: "body"
    class_name: "ig-post-caption"

<PostCommentsButton@button>:
    variant: "text"
    class_name: "ig-comments-button"

<Sidebar@box_layout>:
    direction: "column"
    gap: "md"
    class_name: "ig-sidebar"

<ProfilePanel@box_layout>:
    direction: "column"
    gap: "md"
    class_name: "ig-profile-panel"

<ProfileRow@box_layout>:
    direction: "row"
    gap: "sm"
    class_name: "ig-profile-row"

<ProfileAvatar@avatar>:
    size: "large"
    class_name: "ig-profile-avatar"

<ProfileIdentity@box_layout>:
    direction: "column"
    gap: "xs"
    class_name: "ig-profile-identity"

<ProfileUsername@label>:
    typography: "label"
    class_name: "ig-profile-username"

<ProfileName@label>:
    typography: "caption"
    class_name: "ig-profile-name"

<ProfileSwitch@button>:
    variant: "text"
    class_name: "ig-profile-switch"

<SuggestionsHeader@label>:
    typography: "label"
    class_name: "ig-suggestions-header"

<SuggestionRow@box_layout>:
    direction: "row"
    gap: "sm"
    class_name: "ig-suggestion-row"

<SuggestionAvatar@avatar>:
    size: "medium"
    class_name: "ig-suggestion-avatar"

<SuggestionIdentity@box_layout>:
    direction: "column"
    gap: "xs"
    class_name: "ig-suggestion-identity"

<SuggestionUsername@label>:
    typography: "label"
    class_name: "ig-suggestion-username"

<SuggestionReason@label>:
    typography: "caption"
    class_name: "ig-suggestion-reason"

<FollowButton@button>:
    variant: "text"
    class_name: "ig-follow-button"

<SidebarFooter@label>:
    typography: "caption"
    class_name: "ig-sidebar-footer"

<BottomNavigation@box_layout>:
    direction: "row"
    gap: "md"
    class_name: "ig-bottom-nav"

<CreateOverlay@box_layout>:
    direction: "column"
    gap: "md"
    class_name: "ig-create-overlay"

<CreateDialog@box_layout>:
    direction: "column"
    gap: "md"
    class_name: "ig-create-dialog"

<CreateDialogHeader@box_layout>:
    direction: "row"
    gap: "sm"
    class_name: "ig-create-dialog-header"

<CreateCaption@textfield>:
    variant: "outlined"
    class_name: "ig-caption-field"

<CreateDialogActions@box_layout>:
    direction: "row"
    gap: "sm"
    class_name: "ig-create-dialog-actions"